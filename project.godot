; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Driving Game"
run/main_scene="uid://cc3i8r8ii5l46"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"
<<<<<<<HEADconfig/name="driving-game"

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
XrSimulator="*res://addons/xr-simulator/XRSimulator.tscn"
Globals="*res://Scripts/globals.gd"
UserData="*res://Scripts/user_data.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[global_group]

pausable="nodes that can be paused when the game is paused"

[input]

